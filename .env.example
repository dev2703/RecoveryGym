# RecoveryGym environment variables (copy to .env — never commit real keys)

# Reactor / WAM
REACTOR_API_KEY=
REACTOR_MODEL_NAME=reactor/helios
REACTOR_COUNTERFACTUAL_COMMAND=counterfactual_rollout
USE_MOCK_WAM=true

# Hugging Face
HF_TOKEN=
HF_DATASET_REPO=your-username/recoverygym-recovery
HF_MODEL_REPO=your-username/recoverygym-smolvla-recovery

# SmolVLA
SMOLVLA_MODEL_ID=lerobot/smolvla_base
SMOLVLA_CHECKPOINT=
SMOLVLA_DEVICE=auto
SMOLVLA_ALLOW_FALLBACK=true

# Storage & deployment
RECOVERYGYM_ARTIFACTS_DIR=./artifacts
USE_MODAL_JOBS=false
MODAL_ENVIRONMENT=
CORS_ORIGINS=*

# Frontend (Vercel only — public)
NEXT_PUBLIC_API_URL=http://localhost:8000
